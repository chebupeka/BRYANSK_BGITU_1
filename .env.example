# stub: офлайн, сохраняет исходный текст; unavailable: демонстрация ошибки 503.
# openai: OpenAI-совместимый транспорт со штатной политикой сохранения исходника.
# llm: обработчик роли 2 — исправление текста и сверка фактов. Оба требуют LLM_MODEL.
TEXT_PROCESSOR=stub

# Точка сборки команды: создайте app/team_app.py и укажите app.team_app:app.
# Это параметр Compose; менять маршруты или Dockerfile для подключения модулей не нужно.
APP_MODULE=app.main:app

# Из Docker к модели на компьютере: host.docker.internal (не localhost).
# При запуске backend без Docker замените адрес на http://localhost:11434/v1.
# Для optional Compose-профиля ollama: http://ollama:11434/v1.
# Для внешнего API укажите HTTPS base URL, оканчивающийся на /v1.
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Для Ollama, например: qwen2.5:7b-instruct.
LLM_MODEL=
# Для локального провайдера ключ может быть пустым; реальные ключи не коммитить.
LLM_API_KEY=
# Локальная модель отвечает дольше внешнего API: для неё разумно 120. Предел — 300.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=4096
# Не более одного повтора при невалидном ответе модели; 0 отключает повтор.
LLM_MAX_RETRIES=1
# json_object или none (если совместимый провайдер не поддерживает JSON mode).
LLM_RESPONSE_FORMAT=json_object

# JSON-массив разрешённых источников. Для nginx/Vite proxy достаточно [].
# Для прямого вызова API из браузера: ["http://localhost:5173"]
CORS_ORIGINS=[]
CACHE_MAX_ENTRIES=128
CACHE_TTL_SECONDS=300
MAX_CONCURRENT_PROCESSES=4
