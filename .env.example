# Режимы обработчика: stub (перенос без правок), unavailable (демонстрация сбоя),
# llm (исправление текста локальной моделью через Ollama).
TEXT_PROCESSOR=stub

# Модель через OpenAI-совместимый API. Нужны только при TEXT_PROCESSOR=llm.
# Ollama на этом компьютере:            http://localhost:11434/v1
# Compose с профилем llm:               http://ollama:11434/v1
# Ollama на хосте, backend в Docker:    http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# Ollama ключ не проверяет; поле нужно для других OpenAI-совместимых серверов.
# Секреты не коммитить.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
